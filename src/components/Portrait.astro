---
import { Picture } from "astro:assets";
import portrait from "../assets/img/portrait.jpg";
---

<div class="portrait">
  <Picture
    src={portrait}
    alt="Portrait of Serhii Yahdzhyiev"
    formats={["avif", "webp"]}
    widths={[220, 440]}
    width={220}
    height={220}
    loading="eager"
  />
</div>

<style>
  .portrait {
    width: 220px;
    height: 220px;
    border-radius: var(--rd-lg);
    border: 3px solid var(--clr-border-subtle);
    overflow: hidden;
    flex-shrink: 0;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(20%);
  }
</style>
