---
import Page from "../layouts/Page.astro";
import { main } from "../data/main.ts";
import { getCollection } from "astro:content";

const recentPosts = (
    await getCollection("blog", ({ data }) => !data.draft)
  )
  .sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
  )
  .slice(0, 3);

function formatDate(d: Date) {
  return d.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<Page
  title="SY — Serhii Yahdzhyiev"
  description="Software engineer and musician"
>
  <div class="landing">
    <!-- Hero -->
    <section class="hero">
      <div class="hero__inner">
        <div class="hero__content">
          <p class="hero__label">Hello, I'm</p>
          <h1 class="hero__name">{main.handle}</h1>
          <p class="hero__full-name">{main.full_name}</p>
          <p class="hero__tagline">{main.title}</p>
          <p class="hero__bio">
            Building software, making music and producing videos no
            one ever watches or cares about.
          </p>
          <div class="hero__actions">
            <a
              href="/cv.pdf"
              download="Serhii_Yahdzhyiev_CV.pdf"
              class="btn btn--primary"
            >
              Download CV
            </a>
            <a href="/blog/" class="btn btn--ghost">Read blog</a>
          </div>
        </div>
        <div class="hero__portrait">
          <img
            src="/portrait.png"
            alt="Portrait of Serhii Yahdzhyiev"
            width="320"
            height="320"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <!-- Sections -->
    <section class="sections">
      <div class="sections__inner">
        <a href="/music/" class="section-card">
          <div class="section-card__icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 18V5l12-2v13"></path>
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="18" cy="16" r="3"></circle>
            </svg>
          </div>
          <h2 class="section-card__title">Music</h2>
          <p class="section-card__desc">
            Original tracks.
          </p>
        </a>

        <a href="/videos/" class="section-card">
          <div class="section-card__icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m22 8-6 4 6 4V8z"></path>
              <rect width="14" height="12" x="2" y="6" rx="2" ry="2"></rect>
            </svg>
          </div>
          <h2 class="section-card__title">Videos</h2>
          <p class="section-card__desc">
            Performances and DYI productions.
          </p>
        </a>

        <a href="/blog/" class="section-card">
          <div class="section-card__icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
            </svg>
          </div>
          <h2 class="section-card__title">Blog</h2>
          <p class="section-card__desc">
            General writing about everything.
          </p>
        </a>
      </div>
    </section>

    <!-- Recent posts -->
    {
      recentPosts.length > 0 && (
        <section class="recent-posts">
          <div class="recent-posts__inner">
            <h2 class="section-heading">Recent writing</h2>
            <ul class="post-list">
              {recentPosts.map((post) => (
                <li class="post-list__item">
                  <a href={`/blog/${post.slug}/`} class="post-list__link">
                    <span class="post-list__title">{post.data.title}</span>
                    <time
                      class="post-list__date"
                      datetime={post.data.publishedAt.toISOString()}
                    >
                      {formatDate(post.data.publishedAt)}
                    </time>
                  </a>
                </li>
              ))}
            </ul>
            <a href="/blog/" class="view-all">
              All posts →
            </a>
          </div>
        </section>
      )
    }

    <!-- Social links -->
    <section class="social">
      <div class="social__inner">
        <a
          href={main.links.github}
          target="_blank"
          rel="noreferrer"
          class="social__link"
        >
          GitHub
        </a>
        <span class="social__sep" aria-hidden="true">/</span>
        <a
          href={main.links.youtube}
          target="_blank"
          rel="noreferrer"
          class="social__link"
        >
          YouTube
        </a>
        <span class="social__sep" aria-hidden="true">/</span>
        <a
          href={main.links.soundcloud}
          target="_blank"
          rel="noreferrer"
          class="social__link"
        >
          SoundCloud
        </a>
        <span class="social__sep" aria-hidden="true">/</span>
        <a
          href={main.links.linkedin}
          target="_blank"
          rel="noreferrer"
          class="social__link"
        >
          LinkedIn
        </a>
      </div>
    </section>
  </div>
</Page>

<style>
  .landing {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  /* Hero */
  .hero {
    padding: var(--sp-8) var(--sp-5);
    border-bottom: 1px solid var(--clr-border-subtle);
  }

  .hero__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--sp-8);
    align-items: center;
  }

  .hero__label {
    font-family: var(--ff-mono);
    font-size: var(--fs-0);
    color: var(--clr-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--sp-3);
  }

  .hero__name {
    font-size: var(--fs-6);
    line-height: 1;
    margin: 0 0 var(--sp-2);
    letter-spacing: -0.02em;
  }

  .hero__full-name {
    font-family: var(--ff-mono);
    font-size: var(--fs-1);
    color: var(--clr-text-muted);
    margin-bottom: var(--sp-3);
  }

  .hero__tagline {
    font-size: var(--fs-2);
    color: var(--clr-text-secondary);
    margin-bottom: var(--sp-5);
  }

  .hero__bio {
    max-width: 52ch;
    color: var(--clr-text-secondary);
    line-height: var(--lh-body);
    margin-bottom: var(--sp-6);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  .hero__portrait img {
    width: 220px;
    height: 220px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--clr-border-subtle);
    filter: grayscale(20%);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0.6em 1.2em;
    border-radius: var(--rd-md);
    font-size: var(--fs-1);
    font-weight: var(--fw-medium);
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
    cursor: pointer;
  }

  .btn--primary {
    background: var(--clr-accent);
    color: var(--clr-bg-body);
    border: 1px solid var(--clr-accent);
  }

  .btn--primary:hover {
    opacity: 0.85;
  }

  .btn--ghost {
    background: transparent;
    color: var(--clr-text-primary);
    border: 1px solid var(--clr-border-strong);
  }

  .btn--ghost:hover {
    background: var(--clr-surface-1);
  }

  /* Section cards */
  .sections {
    padding: var(--sp-8) var(--sp-5);
    border-bottom: 1px solid var(--clr-border-subtle);
  }

  .sections__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }

  .section-card {
    display: block;
    padding: var(--sp-6);
    background: var(--clr-bg-surface);
    border: 1px solid var(--clr-border-subtle);
    border-radius: var(--rd-lg);
    text-decoration: none;
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .section-card:hover {
    box-shadow: var(--sh-surface-2);
    transform: translateY(-2px);
    border-color: var(--clr-border-strong);
  }

  .section-card__icon {
    color: var(--clr-text-muted);
    margin-bottom: var(--sp-4);
  }

  .section-card__title {
    font-size: var(--fs-3);
    color: var(--clr-text-primary);
    margin: 0 0 var(--sp-2);
    font-family: var(--ff-display);
  }

  .section-card__desc {
    font-size: var(--fs-1);
    color: var(--clr-text-muted);
    line-height: var(--lh-body);
    margin: 0;
  }

  /* Recent posts */
  .recent-posts {
    padding: var(--sp-8) var(--sp-5);
    border-bottom: 1px solid var(--clr-border-subtle);
  }

  .recent-posts__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-heading {
    font-size: var(--fs-3);
    margin: 0 0 var(--sp-6);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-list__item {
    border-bottom: 1px solid var(--clr-border-subtle);
  }

  .post-list__item:first-child {
    border-top: 1px solid var(--clr-border-subtle);
  }

  .post-list__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-4) 0;
    text-decoration: none;
    color: var(--clr-text-primary);
    gap: var(--sp-4);
    transition: color 0.15s ease;
  }

  .post-list__link:hover .post-list__title {
    color: var(--clr-accent);
  }

  .post-list__title {
    font-size: var(--fs-2);
    font-weight: var(--fw-medium);
    transition: color 0.15s ease;
  }

  .post-list__date {
    font-family: var(--ff-mono);
    font-size: var(--fs-0);
    color: var(--clr-text-muted);
    flex-shrink: 0;
  }

  .view-all {
    font-family: var(--ff-mono);
    font-size: var(--fs-0);
    color: var(--clr-text-muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.15s ease;
  }

  .view-all:hover {
    color: var(--clr-text-primary);
  }

  /* Social */
  .social {
    padding: var(--sp-6) var(--sp-5);
  }

  .social__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  .social__link {
    font-family: var(--ff-mono);
    font-size: var(--fs-0);
    color: var(--clr-text-muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.15s ease;
  }

  .social__link:hover {
    color: var(--clr-text-primary);
  }

  .social__sep {
    color: var(--clr-border-strong);
    font-family: var(--ff-mono);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__portrait {
      display: none;
    }

    .sections__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
